# Copy to .env and replace every CHANGE_ME. Never commit .env.
# Generate each secret with:  openssl rand -hex 32
SHIELD_TOKEN_KEY=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
POSTGRES_OWNER_PASSWORD=CHANGE_ME
POSTGRES_WRITER_PASSWORD=CHANGE_ME
POSTGRES_AUDITOR_PASSWORD=CHANGE_ME
SHIELD_PORT=8080
# Optional: Slack/Teams incoming-webhook URL for human-in-the-loop approvals, and the public base URL of the API
SHIELD_HITL_WEBHOOK_URL=
SHIELD_HITL_CALLBACK_BASE=http://localhost:8080
# Set to runsc to run sandboxes under gVisor (requires runsc installed in the dind image)
SHIELD_SANDBOX_RUNTIME=
